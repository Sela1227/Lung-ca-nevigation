# 開發暫存
_pack/
*.bak
*.tmp
*~

# 打包輸出（不入 repo，避免每版肥大）
*.zip
!SELA-Starter-Kit*.zip

# 個人實驗
scratch/
sandbox/
test-data/

# 編輯器暫存
*.orig
.history/
